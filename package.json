{
  "name": "kw-community-site",
  "version": "1.0.0",
  "private": true,
  "description": "Статичний сайт-каталог спеціалістів громади Kitchener-Waterloo",
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "serve": "http-server . -p 8080 -s"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "http-server": "^14.1.1",
    "vitest": "^2.1.0"
  }
}
